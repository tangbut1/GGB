# Python 缓存与临时文件
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.log

# 虚拟环境与环境变量
.venv/
venv/
.env
.env.*
.envrc
*.env

# IDE / 编辑器配置
.vscode/
.idea/

# 数据与输出
data/
results/
logs/
*.csv
*.xlsx
*.json
*.db
*.png
*.jpg
*.pdf
*.docx

# 依赖清单是工程文件，不是数据输出。上面的 *.json 会把它们一起吞掉，
# 克隆下来就没法 npm install / 复现依赖版本，所以显式放行。
!package.json
!package-lock.json

# Jupyter
.ipynb_checkpoints/
*.ipynb

# 构建与打包文件
build/
dist/
*.egg-info/
*.egg
*.whl

# 系统文件
.DS_Store
Thumbs.db
frontend/node_modules/

# 安全扫描器工作目录
.mimosa/
